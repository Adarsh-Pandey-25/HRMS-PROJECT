NODE_ENV=development
# Local: 127.0.0.1 is fine. On Render leave HOST unset (or set 0.0.0.0). Never use 127.0.0.1 on Render.
HOST=127.0.0.1
# Local only. On Render do NOT set PORT — Render injects it automatically.
PORT=5000

# Supabase
SUPABASE_URL=your_supabase_url
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_KEY=your_service_key

# JWT
JWT_SECRET=your_jwt_secret_min_32_chars
JWT_REFRESH_SECRET=your_refresh_secret_min_32_chars
JWT_EXPIRE=24h
JWT_REFRESH_EXPIRE=7d

# Office IP
OFFICE_IP=182.69.179.236
OFFICE_CIDR=182.69.179.236/32
ALLOW_REMOTE_LOGIN=false

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
# Local: 587 is fine. On Render use 465 (587 often times out).
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=HRMS <noreply@yourcompany.com>

# Comma-separated exact browser origins; never use *
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,https://hrms.spaxads.net,https://hrms-ten-lac.vercel.app
COOKIE_SECURE=false

# File Upload
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=pdf,doc,docx,jpg,jpeg,png

# Timezone
TZ=Asia/Kolkata
WORK_HOURS=9
AUTO_CHECKOUT_TIME=04:00

# Rate Limiting (per user/email/IP, per minute)
RATE_LIMIT_WINDOW=1
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
BOOTSTRAP_RATE_LIMIT_MAX=5

# Platform Super Admin (seeded once if table empty)
SUPER_ADMIN_EMAIL=superadmin@yourcompany.com
SUPER_ADMIN_PASSWORD=change_me_strong_password
SUPER_ADMIN_NAME=Platform Super Admin

