# Spaxads HRMS backend — environment variables (audit finding M-20)
# Copy to .env and fill in real values. Never commit the real .env file.

# ── Secrets ──────────────────────────────────────────────────────────────
# JWT signing secrets. Must each be at least 32 characters — server.js
# refuses to boot otherwise. Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_REFRESH_SECRET=
# Audit finding N-18: separate access-token secret for the super-admin
# platform system (superAdmin.service.js/superAdmin.middleware.js) — keeps
# a leak of one auth system's secret from compromising the other. Optional:
# falls back to JWT_SECRET when unset, so this doesn't force an immediate
# cutover. IMPORTANT — setting this (or changing it later) invalidates
# every currently-issued super-admin access token immediately, since they
# were signed with whatever secret was in effect before; this is a
# deliberate deploy-coordination step, not something to set casually
# without expecting active super-admin sessions to be logged out.
SUPER_ADMIN_JWT_SECRET=
# Token lifetimes — access token stays in an httpOnly cookie, refreshed via
# the hashed refresh_tokens table.
JWT_EXPIRE=24h
JWT_REFRESH_EXPIRE=7d
# Supabase project credentials (Project Settings -> API).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Optional — Supabase Management API (a DIFFERENT credential from
# SUPABASE_SERVICE_KEY above, which only reaches this project's own
# Postgres via PostgREST). Generate an sbp_... token from the Supabase
# dashboard: Account Settings -> Access Tokens. Lets System Health surface
# real PITR/native-backup status alongside the app-level backup mechanism.
# Without these two set, that check honestly reports "unknown" rather than
# a fake green checkmark.
SUPABASE_MANAGEMENT_TOKEN=
SUPABASE_PROJECT_REF=
# First platform super admin — set only the email (an identifier, also
# reused as the alert-recipient address elsewhere, not a secret) and the
# account is created automatically at boot the first time no super_admins
# row exists for it. There is deliberately no password variable here: a
# cryptographically random temporary password is generated at that moment,
# hashed into the database, and printed ONCE to the server startup log —
# never stored in .env or anywhere in plaintext. Log in with it and change
# it immediately, then enable 2FA. On every later boot this is a no-op.
# Optional. Super admins are stored in the database (super_admins table):
# create the first one with `npm run super-admin` and add more from
# Super Admin → Admin Users. If set, this address is created as a super
# admin on first boot (password printed once) and also receives platform
# alerts alongside the super admins in the database.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_NAME=Platform Super Admin
# REQUIRED — the server refuses to boot without it (server.js validates the
# length at startup). Encrypts TOTP secrets at rest for BOTH super-admin 2FA
# AND employee self-service 2FA (utils/totp.js AES-256-GCM; employee 2FA
# deliberately shares this key rather than having its own).
# Must decode to exactly 32 bytes — a 44-char base64 or 64-char hex string.
# A wrong-length value is now rejected outright; it used to be silently
# SHA-256'd into a different key, which made typos undetectable.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# NEVER ROTATE once anyone has enrolled: rotating locks every 2FA user out of
# login, and they only ever see "invalid code" (the cause is logged server-side).
SUPER_ADMIN_2FA_ENC_KEY=
# Required for outbound webhooks (Settings -> Integrations) — AES-256-GCM
# encrypts each webhook's signing secret at rest (utils/webhookCrypto.js).
# 32 bytes, base64 or hex, same generation command as above. Deliberately a
# SEPARATE key from SUPER_ADMIN_2FA_ENC_KEY — different secret class,
# different rotation lifecycle. Rotating this invalidates every existing
# webhook's signature (deliveries will sign with garbage) — recreate
# webhooks after rotating.
WEBHOOK_SECRET_ENC_KEY=
# Required in production (server.js exits without it). HMAC-SHA256 key that
# signs audit-log rows so tampering is detectable (utils/auditIntegrity.js).
# 32 bytes, base64 or hex, same generation command as above.
# Unset in development it falls back to JWT_SECRET with a warning — which is
# why it must be set in production: otherwise rotating JWT_SECRET silently
# invalidates every existing audit-log signature.
AUDIT_LOG_HMAC_KEY=
# SMTP credentials — password reset / OTP / welcome / payslip-failure alert emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Spaxads HRMS <no-reply@example.com>"
# Optional alternate email delivery path (Resend API) — leave unset to use SMTP only.
RESEND_API_KEY=

# ── Topology / deployment ───────────────────────────────────────────────
NODE_ENV=development
HOST=127.0.0.1
PORT=5000
# The frontend's own origin — used for cookie SameSite heuristics and CORS.
FRONTEND_URL=http://localhost:5173
# Comma-separated extra allowed CORS origins beyond FRONTEND_URL and the
# built-in defaults (localhost, the production frontend domains).
CORS_ORIGINS=
# Subdomain-per-tenant base domain (e.g. spaxads.net) — enables
# {slug}.BASE_DOMAIN tenant resolution when set; inert/unscoped when unset.
BASE_DOMAIN=
# Cookie SameSite: explicit override, one of strict|lax|none. Takes priority
# over COOKIE_CROSS_SITE below. Leave both unset to use the legacy
# same-host heuristic (see auth.controller.js's cookieOptions).
COOKIE_SAMESITE=
# Alternative to COOKIE_SAMESITE: true maps to SameSite=None (required for a
# genuinely cross-origin frontend/backend deployment), false maps to Lax.
COOKIE_CROSS_SITE=
COOKIE_SECURE=true
# Set by Render/most PaaS automatically — do not set manually unless testing
# the production host-binding branch locally.
RENDER=

# ── Attendance / office IP ──────────────────────────────────────────────
OFFICE_IP=
OFFICE_CIDR=
ALLOW_REMOTE_LOGIN=false
WORK_HOURS=9
AUTO_CHECKOUT_TIME=04:00
TZ=Asia/Kolkata
# Fallback company name printed on a generated payslip PDF when a company's
# own profile has no name set yet.
COMPANY_NAME=

# ── Uploads ──────────────────────────────────────────────────────────────
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=pdf,doc,docx,jpg,jpeg,png
# Max training video upload size in MB — Supabase Storage free tier caps at 50MB/file.
TRAINING_VIDEO_MAX_MB=50

# ── Rate limiting ────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW=1
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
BOOTSTRAP_RATE_LIMIT_MAX=10
ONBOARDING_OTP_RATE_LIMIT_MAX=30
ADMS_RATE_LIMIT_MAX=120

# ── Cron thresholds ─────────────────────────────────────────────────────
# Days before joining_date to send pre-joining reminder email.
PRE_JOINING_DAYS_BEFORE=2
# Leave balance (days) below which an employee receives a low-balance alert.
LEAVE_LOW_THRESHOLD=3

# ── SaaS billing / marketing ────────────────────────────────────────────
# Free-trial length in days for new workspaces (trialing subscriptions).
TRIAL_DAYS=7
# GST applied on top of every plan price / invoice amount (prices are stored ex-GST).
GST_RATE=0.18
# Supplier GSTIN printed on invoice PDFs (leave empty until registered).
PLATFORM_GSTIN=
# Sales inbox used in trial-ended emails.
SALES_EMAIL=sales@spaxsync.com
# Max public lead/trial requests per IP per hour (POST /api/public/leads).
PUBLIC_LEAD_RATE_LIMIT_MAX=5

# Set to true to skip every scheduled job (billing, payroll, attendance
# alerts, digests, birthday emails, backups). Use it for a local run that
# points at a live database, so it does not act alongside production.
# Leave unset in production.
DISABLE_CRONS=
