{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://hrms-project-l021.onrender.com/api/:path*"
    },
    {
      "source": "/iclock/:path*",
      "destination": "https://hrms-project-l021.onrender.com/iclock/:path*"
    },
    {
      "source": "/((?!api/|iclock/).*)",
      "destination": "/index.html"
    }
  ]
}
