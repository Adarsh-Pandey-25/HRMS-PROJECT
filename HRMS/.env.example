# Build-time configuration for the frontend.
#
# PRERENDER_API_URL is REQUIRED: `npm run build` hard-fails without it,
# because the marketing pre-render step fetches live plan pricing.
# Set ALLOW_PRERENDER_WITHOUT_API=1 instead to build with prices loaded in
# the browser at runtime rather than baked into the HTML.
#
# Typical production build:
#   VITE_BASE_DOMAIN=spaxsync.com PRERENDER_API_URL=http://127.0.0.1:5050 npm run build

# Backend API base URL. If it doesn't already end in /api, /api is appended.
VITE_API_URL=

# The real domain this deployment's tenant subdomains live on
# ({slug}.VITE_BASE_DOMAIN), shown to super-admins generating onboarding
# invites and to companies mid-onboarding. Must match the backend's own
# BASE_DOMAIN (see backend/.env.example) — same value, one deployed on each
# side. Leave unset and both screens clearly say "base domain not
# configured yet" instead of guessing.
VITE_BASE_DOMAIN=

# Backend origin the marketing pre-render step calls for plan pricing at BUILD
# time (scripts/prerender.mjs). Not baked into the client bundle — it only has
# to be reachable from the machine running the build, so the loopback address
# of the backend on the same host is the normal value.
# e.g. http://127.0.0.1:5050
PRERENDER_API_URL=

# Escape hatch: set to 1 to let `npm run build` succeed without
# PRERENDER_API_URL. Pages then fetch prices in the browser instead of having
# them pre-rendered into the HTML (worse for SEO, still correct for users).
ALLOW_PRERENDER_WITHOUT_API=
