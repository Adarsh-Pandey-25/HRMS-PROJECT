{
  "installCommand": "npm install --prefix HRMS",
  "buildCommand": "npm run build --prefix HRMS",
  "outputDirectory": "HRMS/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://hrms-project-l021.onrender.com/api/:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
